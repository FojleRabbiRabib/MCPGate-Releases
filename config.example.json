// MCPGate workspace config example — copy to .mcpgate/config.json and edit.
// Loaded for new requests/sessions and retained while stateful sessions for this
// workspace are active. Active workspace files are watched: valid edits publish
// to matching reloadable sessions, while invalid edits keep the last-known-good
// workspace overlay without restarting the server.
//
// Cascade: built-in defaults → ~/.mcpgate/config.json → this file.
// Workspace configs may extend explicit agent command permissions and allowed
// paths, but cannot add or replace bridge/boost process topology. Resource and
// configured-upstream policy may only be TIGHTENED (never loosened).
//
// Run `mcpgate config show` inside this workspace to inspect the merged result.
{
  "version": "1.0.0",

  // Workspace boost settings are tighten-only. The named upstream must already
  // exist in trusted global configuration; workspace config cannot replace its
  // executable, arguments, working directory, environment, startup, or health policy.
  "boost": {
    "degradeOnUpstreamFailure": false,
    "upstreams": {
      "project": {
        "required": true,
        "startupTimeoutMs": 10000,
        "requestTimeoutMs": 20000
      }
    }
  },

  // ── Security extensions ────────────────────────────────────────────────
  "permissions": {
    // Extra binaries for agent execute_command. This does not add or authorize
    // a new bridge/boost upstream executable.
    "additionalAllowedCommands": [],

    // Appended to the global additionalAllowedPaths list (append-only).
    "additionalAllowedPaths": [],

    // Override the global enableCommandExecution toggle for this workspace.
    // Omit to inherit the global value.
    // "enableCommandExecution": true,

    // Extra per-command argument blocklists merged on top of the global list.
    // These also constrain bridge/boost subprocess arguments for this workspace.
    "commandArgBlocklist": {}
  },

  // ── Limit overrides ──────────────────────────────────────────────────────
  // Workspace values are tighten-only. Invalid attempts to widen inherited
  // command or execution-memory policy reject the workspace overlay.
  "limits": {
    // "maxFileSize": 5242880,    // bytes  — max readable/writable file size
    // "outputLimit": 102400,     // bytes  — per-tool output truncation threshold
    // "commandTimeout": 30000,   // ms     — subprocess fallback and hard ceiling
    // "batchOutputLimit": 524288, // bytes — batch_execute aggregate response cap
    // "executionMemory": {
    //   "enforcement": "hard-required", // may only strengthen inherited posture
    //   "maxSubprocess": 268435456,
    //   "maxSession": 536870912,
    //   "maxAggregate": 1073741824
    //   // maxHost is global-only and cannot be set in workspace config.
    // }
  },

  // ── Claude Code memory ────────────────────────────────────────────────────
  // Workspace values may only tighten the inherited MCPGate access policy.
  // Claude's auto-memory directory/location and MEMORY.md loading boundary are
  // Claude Code semantics and are not redirected or made configurable here.
  "memory": {
    // "mode": "read-only",       // disabled | read-only | read-write
    // "maxFiles": 100,
    // "maxFileSize": 32768,      // bytes per memory file
    // "maxTotalSize": 2097152,   // aggregate bytes across all memory surfaces
    // "maxSearchResults": 25,
    // "maxSnippetBytes": 1024
  },

  // ── Tool overrides ────────────────────────────────────────────────────────
  "tools": {
    // Override the global tool activation mode for this workspace.
    // "auto"   — activate categories inferred from project-type detection
    // "all"    — activate every tool category
    // "manual" — activate only the categories listed in "enabled"
    // "mode": "auto",

    // Tool CATEGORIES to enable (only when mode = "manual").
    // Known values: android, batch, commands, filesystem, formatting, git,
    //               images, laravel, memory, ml, package_manager, project,
    //               tasks, testing, web
    // "enabled": [],

    // Tool CATEGORIES to suppress even in "auto" or "all" mode.
    // Use category names here — NOT individual tool names.
    // "disabled": ["web"],

    // Override auto-detected project type for this workspace.
    // Known values: go, node, python, rust, ruby, java, kotlin, flutter,
    //               react, vue, angular, php, dotnet, cpp, bash, generic
    // "forceProjectTypes": ["go"],

    // Individual TOOL NAMES to enable within their category.
    // When non-empty, only the listed tools are active inside their category.
    // Takes precedence over disabledTools for the same name.
    // "enabledTools": ["read_file", "write_file", "git_status"],

    // Individual TOOL NAMES to suppress even when their category is active.
    // THIS is the correct field for disabling specific tools by name.
    // Do NOT put tool names under "disabled" — that field is for categories only.
    // "disabledTools": ["git_push", "git_merge", "run_tests", "web_search"],

    // Tighten inherited subprocess budgets for this workspace. Values are
    // milliseconds. A workspace value must be no greater than the currently
    // inherited timeout for that category/tool; otherwise config publication
    // fails and the last-known-good policy remains active.
    "executionTimeouts": {
      "categories": {
        "testing": 20000
      },
      "tools": {
        "run_tests": 15000,
        "test_coverage": 18000
      }
    },

    // Optional execution-memory overrides are also tighten-only relative to the
    // inherited effective category/tool policy. Values are bytes.
    "executionMemory": {
      "categories": {},
      "tools": {}
    }

    // Per-tool destructive-confirmation policy ("auto" | "always" | "never").
    // A workspace may only TIGHTEN (raise a tool toward "always"); loosening
    // toward "never" is ignored unless the GLOBAL config sets
    // tools.allowWorkspaceConfirmOverrides. Honored by tools that perform a
    // confirmable action.
    // "confirm": { "delete_file": "always" }
  }
}
